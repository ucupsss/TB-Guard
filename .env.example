# Environment configuration for TB-Guard ML Pipeline
# Copy this file to .env and configure as needed.

# Hugging Face token (required if downloading gated official HeAR model weights from HF)
# Apply for access at https://huggingface.co/google/hear
HF_TOKEN=

# Synapse credentials (for CODA TB DREAM Challenge access)
# https://www.synapse.org/Synapse:syn31472953
SYNAPSE_AUTH_TOKEN=

# Base directories (defaults to repository relative paths if empty)
TB_GUARD_DATA_DIR=data
TB_GUARD_MODELS_DIR=models
TB_GUARD_CACHE_DIR=.cache/hear_embeddings
TB_GUARD_REPORTS_DIR=reports

# Runtime settings
TB_GUARD_DEVICE=cpu
TB_GUARD_LOG_LEVEL=INFO
