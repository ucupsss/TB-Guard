# Environment configuration for TB-Guard ML Pipeline & Agentic AI
# Copy this file to .env or .env.local and configure as needed.

# Hugging Face token (required if downloading gated official HeAR model weights from HF)
# Apply for access at https://huggingface.co/google/hear
HF_TOKEN=

# Synapse credentials (for CODA TB DREAM Challenge access)
# https://www.synapse.org/Synapse:syn31472953
SYNAPSE_AUTH_TOKEN=

# Base directories (defaults to repository relative paths if empty)
TB_GUARD_DATA_DIR=data
TB_GUARD_MODELS_DIR=models
TB_GUARD_CACHE_DIR=.cache/hear_embeddings
TB_GUARD_REPORTS_DIR=reports

# Runtime settings
TB_GUARD_DEVICE=cpu
TB_GUARD_LOG_LEVEL=INFO

# =============================================================================
# Google Cloud Vertex AI / Service Account (Gemini 2.5 Flash & Pro)
# =============================================================================
GCP_PROJECT_ID=hackathon-primestep-19
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Untuk Vercel / Cloud Run / Production (pilih salah satu opsi):
# Opsi 1 (Vercel): JSON string lengkap dari file Service Account Key (atau Base64)
# GCP_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"hackathon-primestep-19",...}'

# Opsi 2 (Vercel): Parameter credential terpisah
# GCP_CLIENT_EMAIL=hackathon-runtime@hackathon-primestep-19.iam.gserviceaccount.com
# GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opsi 3: Gemini API Key dari Google AI Studio (fallback)
# GEMINI_API_KEY=

# =============================================================================
# Groq Cloud API Pool (85+ Keys dengan Auto-Rotation & Fallback Vercel)
# =============================================================================
# Daftar 85+ keys aktif tersimpan di frontend/groq_keys.txt dan tertanam otomatis di build.
GROQ_API_KEY=
# GROQ_API_KEYS=gsk_...,gsk_...
