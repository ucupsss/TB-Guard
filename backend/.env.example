# Backend Go TB-Guard. Salin ke .env untuk dev lokal (`set -a; . ./.env; set +a; go run .`).
# Di Cloud Run: env biasa lewat cloudbuild.yaml, rahasia lewat Secret Manager (backend/deploy/setup-secrets.sh).
# Nilai berisi & atau spasi harus diberi tanda kutip.

PORT=8080
ALLOWED_ORIGINS=http://localhost:3100      # origin frontend, pisah koma ("*" hanya untuk dev)

# --- Login Google (hanya @gmail.com) ---
GOOGLE_CLIENT_ID=                          # OAuth Web Client ID dari Google Cloud Console
SESSION_SECRET=                            # >= 16 karakter acak; wajib di produksi
# ADMIN_EMAILS=a@gmail.com,b@gmail.com     # kosong = semua pengguna Gmail berperan Admin
# ALLOWED_EMAILS=a@gmail.com               # opsional: hanya email ini yang boleh masuk

# --- Neon PostgreSQL (pooler) ---
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DB_MAX_CONNS=5                             # per instance Cloud Run
DB_SEED=true                               # muat data contoh sekali pada database baru

# --- Neon Object Storage (S3-compatible) ---
S3_ENDPOINT=https://xxx.storage.REGION.aws.neon.tech
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-2
S3_BUCKET=tbguard-recordings
# Batas agar tidak melewati kuota Neon:
UPLOAD_MAX_BYTES=2097152                   # 2 MB per file
UPLOAD_TOTAL_MAX_BYTES=104857600           # 100 MB total seluruh bucket
UPLOAD_MAX_PER_DAY=30                      # per pengguna per 24 jam
UPLOAD_TTL_DAYS=30                         # rekaman lebih lama dihapus otomatis

# --- Google Cloud / Gemini ---
GCP_PROJECT_ID=hackathon-primestep-19
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=                          # dev lokal tanpa gcloud login
# GROQ_API_KEYS=gsk_...,gsk_...            # atau GROQ_KEYS_FILE=groq_keys.txt
